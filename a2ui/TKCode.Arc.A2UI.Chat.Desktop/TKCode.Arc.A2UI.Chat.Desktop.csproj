<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <RootNamespace>TKCode.Arc.A2UI.Chat.Desktop</RootNamespace>
        <AssemblyName>A2UIChat</AssemblyName>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <CETCompat>false</CETCompat>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <ProjectReference Include="../TKCode.Arc.A2UI.Chat/TKCode.Arc.A2UI.Chat.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Fonts/TKCode.Arc.Fonts.csproj" />
    </ItemGroup>
</Project>
