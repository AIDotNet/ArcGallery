<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <RootNamespace>TKCode.Arc.Gallery.Desktop</RootNamespace>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'"></ApplicationManifest>
        <!-- Icon of the Windows executable. The macOS bundle icon is Assets/AppIcon.icns (tools/macos/bundle.sh). -->
        <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
        <!-- Keep Avalonia's compiled resource blobs visible to the AOT linker. -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <PublishAot Condition="'$(PublishAot)' == '' And '$(_IsPublishing)' == 'true'">true</PublishAot>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
        <PublishReferencesSymbols>false</PublishReferencesSymbols>
        <!-- .NET 9+ marks the apphost CET-compatible (hardware shadow stacks), so the gallery would not start on Windows 10
             builds before 21H2 or without recent updates (#76). The gallery is a demo app, so it opts out. -->
        <CETCompat>false</CETCompat>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <ProjectReference Include="../TKCode.Arc.Gallery/TKCode.Arc.Gallery.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Shots/TKCode.Arc.Gallery.Shots.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Content/TKCode.Arc.Gallery.Content.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Fonts/TKCode.Arc.Fonts.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Audio.Native/TKCode.Arc.Audio.Native.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Video.Native/TKCode.Arc.Video.Native.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Pdf.Native/TKCode.Arc.Pdf.Native.csproj" />
        <ProjectReference Include="$(ArcRoot)src/TKCode.Arc.Icons.Lucide/TKCode.Arc.Icons.Lucide.csproj" />
    </ItemGroup>
    <!-- The screenshots and the page text are resource-only assemblies that Avalonia finds by name (avares://). NativeAOT keeps no
         metadata for an assembly whose types nothing uses, so Assembly.Load fails and every docs page reports that it could not
         be loaded; rooting them keeps them in a trimmed and in a NativeAOT publish. -->
    <ItemGroup>
        <TrimmerRootAssembly Include="TKCode.Arc.Gallery.Shots" />
        <TrimmerRootAssembly Include="TKCode.Arc.Gallery.Content" />
    </ItemGroup>
    <!-- The Dock icon of an unbundled run on macOS (MacDockIcon); a .app bundle carries the same file as its own icon. -->
    <ItemGroup>
        <AvaloniaResource Include="Assets/AppIcon.icns" />
    </ItemGroup>
    <!-- The logos of the Friends page: the files the WebAssembly host serves from wwwroot/friends, here as resources (AssetLogoSource). -->
    <ItemGroup>
        <AvaloniaResource Include="../TKCode.Arc.Gallery.Browser/wwwroot/friends/*.png" Link="Friends/%(Filename)%(Extension)" />
    </ItemGroup>
    <!-- The media project references copy all RIDs to the build. An archive or signed app needs only its own RID. -->
    <Target Name="FilterNativeAssetsForPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' != ''">
        <ItemGroup>
            <_OtherRuntimeFiles Include="@(ResolvedFileToPublish)"
                Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
            <ResolvedFileToPublish Remove="@(_OtherRuntimeFiles)" />
        </ItemGroup>
    </Target>
</Project>
