<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ImportWizardHandlersDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <arc:ImportWizard x:Name="Wizard" BatchSize="4" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Text="Load the sample and import it: every batch goes to a fake server that answers in 300 ms, and the third batch fails once." />
    </StackPanel>
</UserControl>
