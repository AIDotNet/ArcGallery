<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PrizeWheelServerDemo">
    <!--
        A single spin with a winner your server drew: the visitor still flicks or holds Spin, but WinnerPicker returns
        the server's answer. After the spin the hub reads "Claimed" and the card has no "Spin again".
    -->
    <StackPanel Spacing="16" MaxWidth="880">
        <arc:PrizeWheel x:Name="Wheel"
                        Label="Conference giveaway wheel"
                        Title="Your welcome gift"
                        Description="One spin per badge. Show the code at the help desk."
                        SizesByWeight="False"
                        IsSingleSpin="True"
                        SpinCompleted="OnSpinCompleted">
            <arc:PrizeWheelSegment Label="Early entry" Weight="40" Detail="Skip the queue at the keynote" Code="CONF-EARLY" />
            <arc:PrizeWheelSegment Label="Tote bag" Weight="25" Detail="Pick one up at the merch stand" Code="CONF-TOTE" />
            <arc:PrizeWheelSegment Label="Free coffee" Weight="20" Detail="Any drink at the lounge bar" Code="CONF-COFFEE" />
            <arc:PrizeWheelSegment Label="Workshop seat" Weight="14" Detail="A reserved seat in any workshop" Code="CONF-SEAT" />
            <arc:PrizeWheelSegment Label="VIP pass" Weight="1" Detail="Speaker dinner and backstage tour" Code="CONF-VIP" IsFeatured="True" />
        </arc:PrizeWheel>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <TextBlock x:Name="Readout"
                       VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <arc:Button Content="Reset the demo" Variant="Ghost" Size="Small" Click="OnReset" />
        </StackPanel>
    </StackPanel>
</UserControl>
