<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WindRoseChartCountAxisDemo">
    <StackPanel Spacing="16">
        <arc:SegmentedControl x:Name="Picker"
                              AutomationProperties.Name="Radial axis"
                              HorizontalAlignment="Center"
                              SelectedValue="percent">
            <arc:SegmentedOption Value="percent" Label="Percent of hours" />
            <arc:SegmentedOption Value="count" Label="Hours" />
        </arc:SegmentedControl>
        <arc:WindRoseChart x:Name="Chart" Label="Harbour station, January 2025" SectorCount="16" Size="300" />
    </StackPanel>
</UserControl>
