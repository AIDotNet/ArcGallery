<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demo="clr-namespace:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.FormDynamicItemsDemo"
             x:DataType="demo:FormContactsModel">
    <arc:Form x:Name="Contacts"
              Width="380"
              HorizontalAlignment="Center"
              ValidateCommand="{Binding ValidateCommand}">
        <StackPanel Spacing="16">
            <!-- Each row's FormItem joins the form when it is added and leaves it when it is removed. -->
            <ItemsControl ItemsSource="{Binding Contacts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="demo:FormContactModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <arc:FormItem Label="{Binding Label}">
                                <arc:Input Text="{Binding Email}" Placeholder="name@example.com" />
                            </arc:FormItem>
                            <arc:Button Grid.Column="1"
                                        Variant="Ghost"
                                        Content="Remove"
                                        VerticalAlignment="Top"
                                        Margin="0,27,0,0"
                                        Click="OnRemove" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:Button Content="Add an email" Variant="Secondary" Command="{Binding AddCommand}" />
                <arc:Button arc:Form.Action="Submit" Content="Save" />
            </StackPanel>
            <TextBlock x:Name="Count" FontSize="12" Opacity="0.7" />
        </StackPanel>
    </arc:Form>
</UserControl>
