<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.OnScreenKeyboardLanguagesDemo">
    <StackPanel MaxWidth="640" Spacing="16">
        <arc:Input x:Name="Street" Label="Straße" Placeholder="Königsallee 12" />
        <arc:OnScreenKeyboard x:Name="Keyboard" Target="{Binding #Street}" Culture="de-DE" />
    </StackPanel>
</UserControl>
