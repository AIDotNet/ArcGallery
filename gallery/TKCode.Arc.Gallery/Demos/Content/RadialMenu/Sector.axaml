<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RadialMenuSectorDemo">
    <StackPanel MaxWidth="640" Spacing="12">
        <Border Height="260"
                CornerRadius="18"
                BorderThickness="1"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <Grid>
                <TextBlock Text="Add to the note with the button below"
                           FontSize="14"
                           Margin="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:Button Variant="Primary"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20"
                            AutomationProperties.Name="Add to note">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="18" />
                    <arc:RadialMenu.Menu>
                        <arc:RadialMenu x:Name="Insert"
                                        Label="Add to note"
                                        Trigger="Click"
                                        StartAngle="-90"
                                        SweepAngle="180">
                            <arc:RadialMenuItem Header="Photo" Icon="{x:Static arc:ArcIcons.Image}" />
                            <arc:RadialMenuItem Header="Camera" Icon="{x:Static arc:ArcIcons.Camera}" />
                            <arc:RadialMenuItem Header="File" Icon="{x:Static arc:ArcIcons.File}" />
                            <arc:RadialMenuItem Header="Link" Icon="{x:Static arc:ArcIcons.Link}" />
                            <arc:RadialMenuItem Header="Note" Icon="{x:Static arc:ArcIcons.SquarePen}" />
                        </arc:RadialMenu>
                    </arc:RadialMenu.Menu>
                </arc:Button>
            </Grid>
        </Border>
        <TextBlock x:Name="Status"
                   Text="Nothing added yet."
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
