<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WorkflowCanvasMixedPortsDemo">
    <!-- The canvas runs top to bottom; the steps of the approval row set PortLayout to LeftToRight themselves. -->
    <arc:WorkflowCanvas x:Name="Canvas"
                        WheelMode="ModifierZoom"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1" />
</UserControl>
