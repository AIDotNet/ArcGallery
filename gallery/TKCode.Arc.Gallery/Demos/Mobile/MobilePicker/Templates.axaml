<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.MobilePickerTemplatesDemo">
    <arcm:Page IsScrollable="True">
        <arcm:Page.Header>
            <arcm:Navbar Title="Wallet" />
        </arcm:Page.Header>
        <StackPanel>
            <arcm:ListGroup Header="Payments">
                <arcm:Picker Name="Currency"
                             Icon="{x:Static arc:ArcIcons.Globe}"
                             Content="Currency"
                             SheetTitle="Show prices in"
                             PlaceholderText="Choose"
                             SelectionChanged="OnSelectionChanged">
                    <arcm:Picker.ItemTemplate>
                        <DataTemplate x:DataType="demos:MobilePickerCurrency">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </arcm:Picker.ItemTemplate>
                </arcm:Picker>
            </arcm:ListGroup>
            <TextBlock Name="Log"
                       Margin="32,4"
                       Text="Nothing chosen yet"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
    </arcm:Page>
</UserControl>
