<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ProgressRingOverviewDemo">
    <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <arc:ProgressRing IsIndeterminate="True" Label="Loading" />
        <arc:ProgressRing Value="68" IsValueVisible="True" Label="Uploading" />
        <arc:ProgressRing Value="100" IsValueVisible="True" Label="Complete" />
    </StackPanel>
</UserControl>
