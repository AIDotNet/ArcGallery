<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SandTextPreviewDemo">
    <!-- Move the pointer through the letters to dig them; pick another word to pour it in. -->
    <StackPanel Spacing="16" MaxWidth="720">
        <Border Padding="12,40,12,16"
                MinHeight="240"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusStep24}"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:SandText x:Name="Sand"
                          Text="Mirage"
                          FontSizeRatio="0.18"
                          VerticalAlignment="Bottom" />
        </Border>
        <arc:SegmentedControl x:Name="Words"
                              AutomationProperties.Name="Word"
                              HorizontalAlignment="Center"
                              SelectedIndex="0">
            <arc:SegmentedOption Value="Mirage" Label="Mirage" />
            <arc:SegmentedOption Value="Sandstorm" Label="Sandstorm" />
            <arc:SegmentedOption Value="Oasis" Label="Oasis" />
        </arc:SegmentedControl>
    </StackPanel>
</UserControl>
