<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ModelViewerPreviewDemo">
    <StackPanel MaxWidth="720" Spacing="12">
        <arc:ModelViewer x:Name="Viewer" Height="540"
                         Source="avares://TKCode.Arc.Gallery/Assets/Graphics3D/Dafeiyu.glb"
                         Environment="None" ToneMapping="None"
                         AutomationProperties.Name="Dafeiyu, a whale-themed character" />
        <arc:SegmentedControl x:Name="Clips" HorizontalAlignment="Center"
                              SelectedValue="Idle" IsEnabled="False" AutomationProperties.Name="Character animation">
            <arc:SegmentedOption Value="Idle" Label="Idle" />
            <arc:SegmentedOption Value="Swim" Label="Swim" />
            <arc:SegmentedOption Value="Wave" Label="Wave" />
            <arc:SegmentedOption Value="Still" Label="Still" />
        </arc:SegmentedControl>
    </StackPanel>
</UserControl>
