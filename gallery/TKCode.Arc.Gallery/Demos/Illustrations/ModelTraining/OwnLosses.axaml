<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ModelTrainingOwnLossesDemo">
    <StackPanel Spacing="16">
        <!-- Your own task and numbers: a spam filter trained for 20 epochs that misses its target. -->
        <arc:ModelTraining x:Name="Card"
                           InputCount="4"
                           Samples="48000"
                           HeldOutSamples="6000"
                           BatchSize="64"
                           Epochs="20"
                           Accuracy="88.6"
                           Target="92"
                           IterationCompleted="OnIterationCompleted" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Text="The loss after each weight update is logged here."
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
